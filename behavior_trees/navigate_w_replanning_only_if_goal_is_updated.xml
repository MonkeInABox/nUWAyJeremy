<!--
  This Behavior Tree replans the global path only when the goal is updated.
-->

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <GoalUpdatedController> <!-- only tick child if goal was updated-->
        <Sequence name="ComputePath">
        <ComputePathThroughPoses goal="{goal}" path="{path}" planner_id="GridBased"/>
        <!-- <SmoothPath smoother_id="simple_smoother" unsmoothed_path="{path}" smoothed_path="{path}"/> -->
        </Sequence>
      </GoalUpdatedController>
      <FollowPath path="{path}"  controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
